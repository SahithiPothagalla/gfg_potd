class Solution {
  public:
    int minimumCost(int x, int s, int m, int l, int cs, int cm, int cl) {
        vector<int> dp(x + l + 1, INT_MAX);
        dp[0] = 0;

        for (int i = 1; i <= x + l; i++) {
            if (i >= s && dp[i - s] != INT_MAX)
                dp[i] = min(dp[i], dp[i - s] + cs);

            if (i >= m && dp[i - m] != INT_MAX)
                dp[i] = min(dp[i], dp[i - m] + cm);

            if (i >= l && dp[i - l] != INT_MAX)
                dp[i] = min(dp[i], dp[i - l] + cl);
        }

        int ans = INT_MAX;
        for (int i = x; i <= x + l; i++) {
            ans = min(ans, dp[i]);
        }

        return ans;
    }
};

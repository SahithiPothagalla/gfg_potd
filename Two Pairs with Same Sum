
class Solution {
public:
    vector<int> findPairs(vector<int>& arr) {
        int n = arr.size();

        unordered_map<int, pair<int, int>> mp;

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {

                int sum = arr[i] + arr[j];

                if (mp.find(sum) != mp.end()) {
                    auto p = mp[sum];

                    if (p.first != i && p.first != j &&
                        p.second != i && p.second != j) {

                        return {p.first, p.second, i, j};
                    }
                }
                else {
                    mp[sum] = {i, j};
                }
            }
        }

        return {-1, -1, -1, -1};
    }
};

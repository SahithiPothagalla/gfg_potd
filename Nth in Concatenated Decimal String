class Solution {
  public:
    char nthCharacter(int n) {
        long long digits = 1;
        long long count = 9;
        long long start = 1;

        // Find the group containing the nth character
        while (n > digits * count) {
            n -= digits * count;
            digits++;
            count *= 10;
            start *= 10;
        }

        // Find the number containing the character
        long long number = start + (n - 1) / digits;

        // Find the digit's position within that number
        int position = (n - 1) % digits;

        string s = to_string(number);
        return s[position];
    }
};

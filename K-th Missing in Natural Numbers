
class Solution {
  public:
    int findKthSmall(vector<int>& arr, int k) {
        sort(arr.begin(), arr.end());

        int low = 1;
        int high = arr.back() + k;

        while (low < high) {
            int mid = low + (high - low) / 2;

            int idx = upper_bound(arr.begin(), arr.end(), mid) - arr.begin();

            int missing = mid - idx;

            if (missing < k) {
                low = mid + 1;
            } else {
                high = mid;
            }
        }

        return low;
    }
};

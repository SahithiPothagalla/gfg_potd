class Solution {
  public:
    int minTime(int n, int s1, int s2) {
        long long low = 0, high = n;
        long long ans = LLONG_MAX;

        while (low <= high) {
            long long mid = low + (high - low) / 2;

            long long t1 = mid * s1;
            long long t2 = (n - mid) * s2;

            ans = min(ans, max(t1, t2));

            if (t1 < t2) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        return ans;
    }
};

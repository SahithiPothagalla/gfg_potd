class Solution {
public:
    int getMaxWeight(string &s) {
        int n = s.size();
        int ans = n;

        for (int i = 0; i < n - 1; ) {
            if (s[i] != s[i + 1]) {
                ans += 2;
                i += 2;
            } else {
                i++;
            }
        }

        return ans;
    }
};

class Solution {
public:
    long long ans = 0;

    void dfs(Node* root, vector<int>& vals) {
        if (!root) return;

        vals.push_back(root->data);
        dfs(root->left, vals);
        dfs(root->right, vals);
    }

    long long mergeCount(vector<int>& a, vector<int>& temp,
                         int l, int r) {
        if (l >= r) return 0;

        int mid = l + (r - l) / 2;
        long long cnt = mergeCount(a, temp, l, mid);
        cnt += mergeCount(a, temp, mid + 1, r);

        int i = l, j = mid + 1, k = l;

        while (i <= mid && j <= r) {
            if (a[i] <= a[j]) {
                temp[k++] = a[i++];
            } else {
                temp[k++] = a[j++];
                cnt += mid - i + 1;
            }
        }

        while (i <= mid) temp[k++] = a[i++];
        while (j <= r) temp[k++] = a[j++];

        for (int p = l; p <= r; p++)
            a[p] = temp[p];

        return cnt;
    }

    int pairsViolatingBST(Node* root) {
        vector<int> vals, temp;
        dfs(root, vals);
        temp.resize(vals.size());

        return mergeCount(vals, temp, 0, (int)vals.size() - 1);
    }
};

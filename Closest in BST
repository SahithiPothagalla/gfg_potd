
class Solution {
  public:
    int minDiff(Node *root, int k) {
        int ans = INT_MAX;

        while (root != nullptr) {
            int diff = abs(root->data - k);
            ans = min(ans, diff);

            // Exact match found
            if (diff == 0)
                return 0;

            // Move towards the possible closest value
            if (k < root->data) {
                root = root->left;
            } else {
                root = root->right;
            }
        }

        return ans;
    }
};

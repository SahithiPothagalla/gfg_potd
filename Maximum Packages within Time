class Solution {
  public:
    int maxPackages(vector<int>& arr, int totalTime) {
        int n = arr.size();
        int sum = 0, maxSum = 0;

        for (int i = 0; i < totalTime; i++) {
            sum += arr[i];
        }

        maxSum = sum;

        for (int i = totalTime; i < n; i++) {
            sum += arr[i] - arr[i - totalTime];
            maxSum = max(maxSum, sum);
        }

        return maxSum;
    }
};

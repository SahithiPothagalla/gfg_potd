
class Solution {
  public:
    string findRollOut(string& s, vector<int>& roll) {
        int n = s.size();
        int k = roll.size();
        int count = 0;

        // Process roll operations from right to left
        for (int i = k - 1; i >= 0; i--) {
            count = (count + 1) % 26;
            roll[i] = count;
        }

        // Apply the total shifts to each character
        for (int i = 0; i < n; i++) {
            int shift = (i < k) ? roll[i] : 0;
            s[i] = (s[i] - 'a' + shift) % 26 + 'a';
        }

        return s;
    }
};

class Solution {
  public:
    string lexiString(string &s) {
        int n = s.size();
        
        string t = s + s;
        int i=0, j=1, k=0;
        while(i < n && j < n && k < n){
            char a = t[i + k];
            char b = t[j + k];
            
            if(a == b){
                k++;
                continue;
            }
            
            if(a > b){
                i = i + k + 1;
            }
            else {
                j = j + k + 1;
            }
            
            if(i == j){
                j++;
            }
            
            k = 0;
        }
        
        return t.substr(min(i, j), n);
    }
};


class Solution {
  public:
    int minimumStep(int n) {
        vector<int> dp(n + 1, 1e9);
        dp[1] = 0;

        for (int i = 1; i <= n; i++) {
            dp[i + 1 <= n ? i + 1 : i] =
                min(dp[i + 1 <= n ? i + 1 : i], dp[i] + 1);

            if (3LL * i <= n) {
                dp[3 * i] = min(dp[3 * i], dp[i] + 1);
            }
        }

        return dp[n];
    }
};


class Solution {
public:
    bool isItPossible(string &s1, string &s2) {
        int n = s1.size();
        int i = 0, j = 0;

        while (i < n && j < n) {
            // Skip empty positions
            while (i < n && s1[i] == '#')
                i++;

            while (j < n && s2[j] == '#')
                j++;

            // Both strings must finish together
            if (i == n || j == n)
                return i == n && j == n;

            // Characters must be identical
            if (s1[i] != s2[j])
                return false;

            // A can only move left
            if (s1[i] == 'A' && i < j)
                return false;

            // B can only move right
            if (s1[i] == 'B' && i > j)
                return false;

            i++;
            j++;
        }

        // Skip remaining empty positions
        while (i < n && s1[i] == '#')
            i++;

        while (j < n && s2[j] == '#')
            j++;

        return i == n && j == n;
    }
};

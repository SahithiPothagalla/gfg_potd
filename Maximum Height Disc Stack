class Solution {
public:
    int maxStackHeight(vector<int> &r, vector<int> &h) {
        int n = r.size();

        vector<pair<int, int>> discs;
        for (int i = 0; i < n; i++) {
            discs.push_back({r[i], h[i]});
        }

        // Sort by radius
        sort(discs.begin(), discs.end());

        // Fenwick tree for maximum value
        // Heights are <= 1000
        vector<int> bit(1002, 0);

        auto query = [&](int idx) {
            int ans = 0;
            while (idx > 0) {
                ans = max(ans, bit[idx]);
                idx -= idx & -idx;
            }
            return ans;
        };

        auto update = [&](int idx, int value) {
            while (idx <= 1000) {
                bit[idx] = max(bit[idx], value);
                idx += idx & -idx;
            }
        };

        int ans = 0;

        int i = 0;

        while (i < n) {
            int j = i;

            // Find all discs having the same radius
            while (j < n && discs[j].first == discs[i].first) {
                j++;
            }

            vector<pair<int, int>> pending;

            // First query, don't update yet.
            // This prevents equal-radius discs from stacking.
            for (int k = i; k < j; k++) {
                int radius = discs[k].first;
                int height = discs[k].second;

                // Need previous height strictly smaller
                int best = query(height - 1);

                int currentHeight = best + height;

                ans = max(ans, currentHeight);

                pending.push_back({height, currentHeight});
            }

            // Now update after processing the whole radius group
            for (auto &p : pending) {
                update(p.first, p.second);
            }

            i = j;
        }

        return ans;
    }
};

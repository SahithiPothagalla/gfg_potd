
class Solution {
  public:
    bool findPattern(string& s) {
        int i = 0;
        int n = s.size();

        while (i < n) {
            // Count consecutive x's
            int xCount = 0;
            while (i < n && s[i] == 'x') {
                xCount++;
                i++;
            }

            // No x found
            if (xCount == 0) return false;

            // Count consecutive y's
            int yCount = 0;
            while (i < n && s[i] == 'y') {
                yCount++;
                i++;
            }

            // Both counts must be equal
            if (xCount != yCount) return false;
        }

        return true;
    }
};

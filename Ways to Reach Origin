class Solution {
  public:
    int MODE=1e9+7;

    int waysUtil(int x, int y, vector<vector<int>> &dp){
      if(x<0 || y<0) return 0;    
      if(x==0 && y==0) return 1;

      if(dp[x][y] != -1) return dp[x][y];

      return dp[x][y]=(waysUtil(x-1, y, dp) + waysUtil(x, y-1, dp))%MODE;
    }


    int ways(int x, int y){
      vector<vector<int>> dp(x+1, vector<int>(y+1, -1));    
      return waysUtil(x, y, dp);
    }
};
